# Decrypted secrets and generated runtime files
runtime/
*.dec
*.plaintext

# Local environment files
.env
.env.*
!.env.example
env/*.env
!env/*.env.example
!env/*.example

# Persistent Caddy data
config/caddy/data/*
!config/caddy/data/.gitkeep
config/caddy/config/*
!config/caddy/config/.gitkeep

# PostgreSQL data
config/postgres/data/
!config/postgres/.gitkeep

# n8n runtime data
config/n8n/data/*
!config/n8n/data/.gitkeep

# Beszel runtime data
config/beszel/data/*
!config/beszel/data/.gitkeep

# Local backup and temporary copies
*.bak
*.backup
*.orig
*.tmp
*.new
*~

# Generated Python and SQLite state
__pycache__/
*.py[cod]
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Downloaded PVP DNS source/cache state
/services/pvp-dns/cache/
/services/pvp-dns/downloads/

# Miscellaneous
*.log
.DS_Store

# Pi-hole runtime state
/config/pihole/

# Local PostgreSQL backups
/backups/postgres/*.sql
